# Copy to .env.local and fill in (see README). Do not commit .env.local.

# Supabase project ref (subdomain before .supabase.co)
VITE_SUPABASE_PROJECT_REF=your-project-ref

# Project Settings → API → anon public key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anonymous Auth must be enabled in Supabase Dashboard → Auth → Providers → Anonymous.

# Optional; must match Edge route prefix in supabase/functions/server/index.tsx
# VITE_EDGE_ROUTE_PREFIX=make-server-e35291a5

# Optional; set ENABLE_DEV_ROUTES=true in Supabase function secrets for dev-info and list-models.

# ── Developer persistent identity (local dev only, do NOT set in production) ──
# Create a Supabase user (email+password) via Dashboard → Authentication → Users.
# Setting these gives you a fixed userId so project data survives session resets.
# VITE_DEV_EMAIL=you@example.com
# VITE_DEV_PASSWORD=your-password

# ── Server-side access tokens (set via `supabase secrets set`) ──
# Comma-separated list of valid access tokens. Users must enter one to use the app.
# The token is verified server-side in auth-middleware.tsx.
# Example: supabase secrets set ACCESS_TOKENS="token-alice,token-bob"

# Image models are not configured via env. Each card type names its model
# explicitly in supabase/functions/server/shared/image-config.tsx.

# Optional; per-attempt image generation timeout in ms (default 80000).
# IMAGE_TIMEOUT_MS=80000
